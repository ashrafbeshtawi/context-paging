# === Provider Configuration ===

# Choose your LLM provider (default: anthropic)
# Options: anthropic | openai | google | mistral | xai | amazon-bedrock | azure | openrouter
AI_PROVIDER=anthropic

# Choose your model (default: depends on provider)
# Anthropic:      claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-5-20251001
# OpenAI:         gpt-4o, gpt-4o-mini, o1, o1-mini
# Google:         gemini-2.0-flash, gemini-2.5-pro
# Mistral:        mistral-large-latest, mistral-small-latest
# xAI:            grok-3, grok-3-mini
# OpenRouter:     openrouter/auto, or any model slug like anthropic/claude-sonnet-4
AI_MODEL=claude-sonnet-4-20250514

# === API Keys (set the one matching your provider) ===
# The web UI also accepts an API key from the browser (stored in
# localStorage only). If a request includes one, it overrides whatever
# is set here for that request.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
AZURE_API_KEY=
OPENROUTER_API_KEY=

# === Database (PostgreSQL) ===
# Sessions, messages and pages are persisted here.
# Defaults match docker-compose.yml so `docker compose up` works out of the box.
PG_HOST=localhost
PG_PORT=5433
PG_USER=context_paging
PG_PASSWORD=context_paging
PG_DATABASE=context_paging
PG_POOL_MAX=10

# === CLI ===
# The CLI uses a single persistent session by default. Override the id to
# keep multiple separate CLI conversations in the same DB.
# CLI_SESSION_ID=cli-default

# === Debug ===
# Enable debug mode to see context window stats and tool call details
# DEBUG=true
